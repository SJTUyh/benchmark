# 基础镜像：指定的Python 3.10.18-bullseye
FROM docker.xuanyuan.me/python:3.10.18-bullseye

# ========== 核心环境变量 ==========
# 时区/编码（bullseye默认UTF-8，但显式指定更稳妥）
    # pip核心配置：普通用户安装到用户目录，禁用缓存（减小镜像体积）
ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_NO_CACHE_DIR=1
ENV PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
    # 自定义用户信息（推荐UID/GID 1000，避免冲突）
ENV APP_USER=ais_bench_smoke
ENV APP_UID=1013
ENV APP_GID=1015
    # 用户主目录（pip安装的包会到 ~/.local）
ENV USER_HOME=/home/${APP_USER}

# ========== 1. Root阶段：安装系统依赖+创建用户 ==========
    # ========== 创建普通用户 ==========
    # 创建用户组 → 创建用户（-m：自动创建主目录） → 设置权限
RUN groupadd -g ${APP_GID} ${APP_USER} && \
    useradd -m -u ${APP_UID} -g ${APP_GID} -d ${USER_HOME} -s /bin/bash ${APP_USER} && \
    # 创建工作目录（后续挂载/代码存放）
    mkdir -p ${USER_HOME}/app && \
    # 赋予普通用户对主目录的完全权限
    chown -R ${APP_USER}:${APP_USER} ${USER_HOME}

# ========== 2. 切换工作目录 ==========
WORKDIR ${USER_HOME}

# ========== 3. 切换到普通用户（核心：后续所有操作非root） ==========
USER ${APP_USER}

RUN git clone https://gh-proxy.test.osinfra.cn/https://github.com/AISBench/benchmark.git  ${USER_HOME}/benchmark

WORKDIR ${USER_HOME}/benchmark

# ========== 4. 验证/预安装依赖（可选） ==========
RUN pip install rouge_chinese --retries 3  -i https://repo.huaweicloud.com/repository/pypi/simple --trusted-host repo.huaweicloud.com --use-pep517
RUN if [ -f "requirements/runtime.txt" ]; then pip install -r requirements/runtime.txt --retries 3 -i https://repo.huaweicloud.com/repository/pypi/simple --trusted-host repo.huaweicloud.com --use-pep517; fi
RUN if [ -f "requirements/extra.txt" ]; then pip install -r requirements/extra.txt --retries 3  -i https://repo.huaweicloud.com/repository/pypi/simple --trusted-host repo.huaweicloud.com --use-pep517; fi
RUN if [ -f "requirements/api.txt" ]; then pip install -r requirements/api.txt --retries 3 -i https://repo.huaweicloud.com/repository/pypi/simple --trusted-host repo.huaweicloud.com --use-pep517; fi
RUN if [ -f "requirements/bfcl_dependencies.txt" ]; then pip3 install -r requirements/datasets/bfcl_dependencies.txt --retries 3 --no-deps -i https://repo.huaweicloud.com/repository/pypi/simple --trusted-host repo.huaweicloud.com --use-pep517; fi
RUN pip3 install nltk==3.8 --retries 3  -i https://repo.huaweicloud.com/repository/pypi/simple --trusted-host repo.huaweicloud.com --use-pep517

WORKDIR ${USER_HOME}

RUN rm -rf ${USER_HOME}/benchmark

# ========== 5. 容器启动命令（按需修改） ==========
CMD ["python", "-c", "print(f'当前用户：{__import__("os").getlogin()}'); print('普通用户运行成功！')"]