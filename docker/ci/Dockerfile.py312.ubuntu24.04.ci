# =============================================================================
# 冒烟测试专用镜像：基于 Docker Hub 的 ubuntu:24.04 + Python 3.12
# -----------------------------------------------------------------------------
# 参考：
#   - 依赖安装内容：docker/ubuntu/Dockerfile.py312.ubuntu24.04
#   - 普通用户配置：docker/ci/Dockerfile.example.smoke（APP_USER=ais_bench_smoke）
# 用途：
#   配合 .github/workflows/run_smoke_test_pr_and_daily.yml，在 self-hosted runner
#   中以非 root 用户身份准备 benchmark 运行环境，最后删除源码（避免源码残留）
# =============================================================================

# ============ 基础镜像 ============
FROM ubuntu:24.04

# ============ 核心环境变量 ============
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# pip 核心配置：普通用户安装到用户目录，禁用缓存
ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_NO_CACHE_DIR=1
ENV PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple

# 自定义用户信息（推荐UID/GID避免冲突）
# 通过 --build-arg 可覆盖为宿主机 ais_bench_smoke 用户信息：
#   docker build --build-arg APP_USER=$(id -un ais_bench_smoke) \
#                 --build-arg APP_UID=$(id -u ais_bench_smoke) \
#                 --build-arg APP_GID=$(id -g ais_bench_smoke) -t ...
ARG APP_USER=ais_bench_smoke
ARG APP_UID=1013
ARG APP_GID=1015

ENV USER_HOME=/home/${APP_USER}

# 关键修复：将 Python 用户目录的 bin 加入 PATH（永久生效）
ENV PATH="${USER_HOME}/.local/bin:${PATH}"

ARG GIT_TAG=latest

# ============ 1. Root 阶段：apt 源配置 + 安装系统依赖 + 安装 Docker ============
RUN ARCH=$(uname -m) && \
    if [ "$(uname -m)" = "x86_64" ]; then \
        echo "deb http://repo.huaweicloud.com/ubuntu/ noble main restricted universe multiverse" > /etc/apt/sources.list && \
        echo "deb http://repo.huaweicloud.com/ubuntu/ noble-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
        echo "deb http://repo.huaweicloud.com/ubuntu/ noble-security main restricted universe multiverse" >> /etc/apt/sources.list && \
        echo "deb http://repo.huaweicloud.com/ubuntu/ noble-backports main restricted universe multiverse" >> /etc/apt/sources.list; \
    else \
        echo "deb http://repo.huaweicloud.com/ubuntu-ports/ noble main restricted universe multiverse" > /etc/apt/sources.list && \
        echo "deb http://repo.huaweicloud.com/ubuntu-ports/ noble-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
        echo "deb http://repo.huaweicloud.com/ubuntu-ports/ noble-security main restricted universe multiverse" >> /etc/apt/sources.list && \
        echo "deb http://repo.huaweicloud.com/ubuntu-ports/ noble-backports main restricted universe multiverse" >> /etc/apt/sources.list; \
    fi && \
    # 一次彻底清理：
    #   1) find 兜底删除所有 docker-* 命名的 apt 钩子（不只 docker-clean，还可能有 docker-no-languages / docker-gpg 等）
    #   2) 删除 Ubuntu 24.04 默认 /etc/apt/sources.list.d/ubuntu.sources（DEB822，会绕过主 sources.list），
    #      否则仍然从 ports.ubuntu.com 下载 67 MB 的源数据
    #   3) 清理 apt lock，避免之前构建残留的锁阻塞本轮 update
    find /etc/apt/apt.conf.d -type f -name 'docker-*' -delete 2>/dev/null || true; \
    rm -f /etc/apt/sources.list.d/ubuntu.sources \
          /var/lib/apt/lists/lock \
          /var/cache/apt/archives/lock && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        curl \
        wget \
        unzip \
        vim \
        lsof \
        net-tools \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        python3-pip \
        iptables \
    && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# ============ 2. 创建普通用户 ==========
RUN groupadd -g ${APP_GID} ${APP_USER} && \
    useradd -m -u ${APP_UID} -g ${APP_GID} -d ${USER_HOME} -s /bin/bash ${APP_USER} && \
    mkdir -p ${USER_HOME}/app && \
    chown -R ${APP_USER}:${APP_USER} ${USER_HOME}

# ============ 2.5 写入普通用户全局 gitconfig（强制走内部 gh-proxy，替换 https / ssh 两种协议） ==========
# 用 printf 单行写（避免 heredoc 在某些 Docker 前端下被当作指令解析导致 build 失败）。
# 同时显式把 http.threads / pack.threads 设为 1，避免受限环境下 git 多线程 DNS 解析失败
#（fatal: getaddrinfo() thread failed to start）。

# ============ 3. 切换工作目录 + 切换到普通用户（关键：后续所有操作非 root） ==========
WORKDIR ${USER_HOME}
USER ${APP_USER}

# ============ 4. 拉取 benchmark 源码（普通用户执行） ==========
# 关键修复：libcurl 7.66+ 默认开启 CURLOPT_DNS_LOCAL_THREADED=1，让 DNS 解析跑在 worker thread。
# 在 self-hosted runner / 受限容器环境下，pthread_create() 因 ulimit(RLIMIT_NPROC/RLIMIT_STACK)
# 或 docker seccomp profile 失败，会抛 'fatal: ... getaddrinfo() thread failed to start'。
# 这里用一个 bash -lc 先把可用资源拉到足够大，再 exec git clone（避免 libcurl 起线程失败）。
RUN bash -lc 'set -e; \
        ulimit -s unlimited 2>/dev/null || true; \
        ulimit -n 65536    2>/dev/null || true; \
        ulimit -u 65535    2>/dev/null || true; \
        echo "[INFO] current ulimit: $(ulimit -a 2>/dev/null | tr "\n" "|")"; \
        GIT_CURL_VERBOSE=1 GIT_TRACE=1 git clone \
            https://gh-proxy.test.osinfra.cn/https://github.com/AISBench/benchmark.git \
            ${USER_HOME}/benchmark'

WORKDIR ${USER_HOME}/benchmark

# 切换到指定 tag（默认 latest 则不切换）
RUN if [ "$GIT_TAG" != "latest" ]; then \
        git fetch --tags && \
        git checkout tags/$GIT_TAG -b $GIT_TAG-branch; \
    fi

# ============ 5. 安装 benchmark 全部 Python 依赖（普通用户身份，安装到 ~/.local） ==========

# 5.1 安装 torch（CPU 版本，先下 wheel 再装）
RUN ARCH=$(uname -m) && \
    wget -P /tmp https://aisbench.obs.cn-north-4.myhuaweicloud.com/images/benchmark/dependencies/torch-2.12.0%2Bcpu-cp312-cp312-manylinux_2_28_${ARCH}.whl && \
    python3.12 -m pip install --no-cache-dir /tmp/torch-2.12.0+cpu-cp312-cp312-manylinux_2_28_${ARCH}.whl \
        -i https://repo.huaweicloud.com/repository/pypi/simple \
        --trusted-host repo.huaweicloud.com \
        --use-pep517 && \
    rm /tmp/torch-2.12.0+cpu-cp312-cp312-manylinux_2_28_${ARCH}.whl

# 5.2 rouge_chinese
RUN pip install --no-cache-dir \
        -i https://repo.huaweicloud.com/repository/pypi/simple \
        --trusted-host repo.huaweicloud.com \
        --use-pep517 \
        rouge_chinese

# 5.3 requirements/runtime.txt
RUN if [ -f "requirements/runtime.txt" ]; then \
        pip install --no-cache-dir \
            -r requirements/runtime.txt \
            -i https://repo.huaweicloud.com/repository/pypi/simple \
            --trusted-host repo.huaweicloud.com \
            --use-pep517; \
    fi

# 5.4 requirements/extra.txt
RUN if [ -f "requirements/extra.txt" ]; then \
        pip install --no-cache-dir \
            -r requirements/extra.txt \
            -i https://repo.huaweicloud.com/repository/pypi/simple \
            --trusted-host repo.huaweicloud.com \
            --use-pep517; \
    fi

# 5.5 requirements/api.txt
RUN if [ -f "requirements/api.txt" ]; then \
        pip install --no-cache-dir \
            -r requirements/api.txt \
            -i https://repo.huaweicloud.com/repository/pypi/simple \
            --trusted-host repo.huaweicloud.com \
            --use-pep517; \
    fi

# 5.6 requirements/datasets/bfcl_dependencies.txt（--no-deps）
RUN if [ -f "requirements/datasets/bfcl_dependencies.txt" ]; then \
        pip install --no-cache-dir \
            -r requirements/datasets/bfcl_dependencies.txt \
            --no-deps \
            -i https://repo.huaweicloud.com/repository/pypi/simple \
            --trusted-host repo.huaweicloud.com \
            --use-pep517; \
    fi

# 5.7 nltk==3.8
RUN pip install --no-cache-dir \
        -i https://repo.huaweicloud.com/repository/pypi/simple \
        --trusted-host repo.huaweicloud.com \
        --use-pep517 \
        nltk==3.8

# 5.8 安装 benchmark 包本身（采用非 -e 模式：彻底安装到 site-packages，确保删除源码后包仍可用）
RUN if [ -f "setup.py" ]; then \
        pip install --no-cache-dir \
            ./ \
            -i https://repo.huaweicloud.com/repository/pypi/simple \
            --trusted-host repo.huaweicloud.com \
            --use-pep517; \
    fi

# ============ 6. 下载 NLTK 离线数据到用户目录 ==========
RUN curl -o /tmp/punkt.zip https://aisbench.obs.cn-north-4.myhuaweicloud.com/images/benchmark/dependencies/punkt.zip && \
    mkdir -p ${USER_HOME}/nltk_data/tokenizers && \
    unzip -q /tmp/punkt.zip -d ${USER_HOME}/nltk_data/tokenizers && \
    rm /tmp/punkt.zip

ENV NLTK_DATA=${USER_HOME}/nltk_data

# 验证 NLTK 安装
RUN python3.12 -c "import nltk; from nltk.tokenize import word_tokenize; tokens = word_tokenize('Hello World! 测试NLTK 3.8离线安装'); print('分词结果：', tokens)"

# ============ 7. 删除工具源码本身（仅保留已安装的依赖，避免源码泄漏/残留） ==========
WORKDIR ${USER_HOME}

RUN rm -rf ${USER_HOME}/benchmark

# ============ 8. 默认启动命令（按需修改） ==========
CMD ["bash", "-c", "echo 'ais_bench_smoke image ready'; echo \"current user: $(whoami)\"; which python3.12; python3.12 -V"]